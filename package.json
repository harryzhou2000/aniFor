{
  "name": "anifor-tpt",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bash scripts/finalize-pages-build.sh",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "audit:browser-input": "node scripts/verify-browser-input.mjs",
    "audit:8x": "node scripts/verify-browser-input.mjs --scale-eight-only",
    "audit:material-atlas": "node scripts/verify-browser-input.mjs --material-atlas-only",
    "audit:explosive-powder": "node scripts/verify-browser-input.mjs --explosive-powder-graphics-only",
    "audit:energy-radioactive": "node scripts/verify-browser-input.mjs --energy-radioactive-graphics-only",
    "audit:organic-plant": "node scripts/verify-browser-input.mjs --organic-plant-graphics-only",
    "audit:sponge": "node scripts/verify-browser-input.mjs --sponge-graphics-only",
    "audit:virus": "node scripts/verify-browser-input.mjs --virus-graphics-only",
    "audit:wax": "node scripts/verify-browser-input.mjs --wax-graphics-only",
    "audit:crystal": "node scripts/verify-browser-input.mjs --crystal-graphics-only",
    "audit:paste-resist": "node scripts/verify-browser-input.mjs --paste-resist-graphics-only",
    "audit:vibr-state": "node scripts/verify-browser-input.mjs --vibr-state-graphics-only",
    "audit:deut-state": "node scripts/verify-browser-input.mjs --deut-state-graphics-only",
    "audit:source-target": "node scripts/verify-browser-input.mjs --source-target-graphics-only",
    "audit:force-activity": "node scripts/verify-browser-input.mjs --force-activity-graphics-only",
    "audit:polo-state": "node scripts/verify-browser-input.mjs --polo-state-graphics-only",
    "audit:spng-state": "node scripts/verify-browser-input.mjs --spng-state-graphics-only",
    "audit:native-seed-growth": "node scripts/verify-browser-input.mjs --native-seed-growth-only",
    "profile:render-fields": "vite-node scripts/profile-render-fields.ts",
    "setup:emsdk": "bash scripts/setup-emsdk.sh",
    "setup:build-tools": "bash scripts/setup-build-tools.sh",
    "build:wasm": "bash scripts/build-tpt-wasm.sh",
    "build:all": "npm run build:wasm && npm run test && npm run build",
    "fetch:tpt": "bash scripts/fetch-powder-toy.sh"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
