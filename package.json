{
  "name": "powder-toy-reimagined",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bash scripts/finalize-pages-build.sh",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "setup:emsdk": "bash scripts/setup-emsdk.sh",
